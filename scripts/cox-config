#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="${COX_PROJECT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
PYTHON_BIN="${COX_PYTHON:-$PROJECT/.venv/bin/python}"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi
ENV_DATA_TOOL="$PROJECT/codexchange_proxy/env_file.py"
ENV_FILE="${COX_ENV_FILE:-$HOME/.config/codexchange/env}"
CODEX_CONFIG="${CODEX_CONFIG_FILE:-$HOME/.codex/config.toml}"
CODEX_DIR="$(dirname "$CODEX_CONFIG")"

mkdir -p "$(dirname "$ENV_FILE")"

ensure_runtime_tools() {
  if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
    echo "ERROR: CodeXchange Python runtime is unavailable" >&2
    return 1
  fi
  if [ ! -f "$ENV_DATA_TOOL" ]; then
    echo "ERROR: CodeXchange env data writer is unavailable" >&2
    return 1
  fi
}

ensure_env_file() {
  ensure_runtime_tools
  {
    printf 'COX_MODEL_API_KEY\0%s\0' ""
    printf 'COX_MODEL_PROVIDER\0%s\0' "deepseek"
    printf 'COX_MODEL\0%s\0' "deepseek-v4-pro"
    printf 'COX_REASONING_EFFORT\0%s\0' "high"
  } | "$PYTHON_BIN" "$ENV_DATA_TOOL" ensure-exports-nul "$ENV_FILE" \
      --header "# codexchange local environment" \
      --header "# Generated by cox-config"
}

set_export_var() {
  local key="$1"
  local value="$2"

  ensure_env_file
  ensure_runtime_tools
  "$PYTHON_BIN" "$ENV_DATA_TOOL" set-export "$ENV_FILE" "$key" "$value"
}

codex_effort_for_cox_effort() {
  case "$1" in
    high) echo "high" ;;
    max) echo "xhigh" ;;
    xhigh) echo "xhigh" ;;
    *)
      echo "ERROR: effort must be high or max" >&2
      return 2
      ;;
  esac
}

codex_profile_path() {
  local profile="$1"
  printf '%s/%s.config.toml\n' "$CODEX_DIR" "$profile"
}

patch_profile_file_key() {
  local profile="$1"
  local key="$2"
  local value="$3"
  local profile_file
  profile_file="$(codex_profile_path "$profile")"

  [ -f "$profile_file" ] || return 0

  "$PYTHON_BIN" - "$profile_file" "$key" "$value" <<'PYCOX_COMMAND_CONFIG_SPLIT_PROFILE_PATCH_P101'
from pathlib import Path
import sys

path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]

def quote_basic(value: str) -> str:
    value = value.replace("\\", "\\\\").replace('"', '\\"')
    value = value.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return f'"{value}"'

text = path.read_text(encoding="utf-8")
lines = text.splitlines()
out = []
found = False
for line in lines:
    stripped = line.strip()
    if stripped.startswith(f"{key} = "):
        out.append(f"{key} = {quote_basic(value)}")
        found = True
    else:
        out.append(line)
if not found:
    out.append(f"{key} = {quote_basic(value)}")
path.write_text("\n".join(out).rstrip() + "\n", encoding="utf-8")
PYCOX_COMMAND_CONFIG_SPLIT_PROFILE_PATCH_P101
}

patch_codex_model() {
  local model="$1"
  patch_profile_file_key "deepseek" "model" "$model"
  patch_profile_file_key "cox" "model" "$model"
}

patch_codex_effort() {
  local cox_effort="$1"
  local codex_effort
  codex_effort="$(codex_effort_for_cox_effort "$cox_effort")"

  patch_profile_file_key "cox" "model_reasoning_effort" "$codex_effort"
  patch_profile_file_key "cox" "plan_mode_reasoning_effort" "high"
}

run_cox_cli() {
  ensure_runtime_tools
  PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" -m codexchange_proxy.cli "$@"
}

runtime_refresh_disabled() {
  case "${COX_CONFIG_RESTART_THINKING:-}" in
    0|false|FALSE|no|NO|off|OFF|disabled|DISABLED|never|NEVER) return 0 ;;
  esac
  case "${COX_CONFIG_REFRESH_RUNTIME:-}" in
    0|false|FALSE|no|NO|off|OFF|disabled|DISABLED|never|NEVER) return 0 ;;
  esac
  case "${COX_POST_CONFIG_APPLY:-}" in
    0|false|FALSE|no|NO|off|OFF|disabled|DISABLED|never|NEVER) return 0 ;;
  esac
  return 1
}

apply_runtime_refresh() {
  if runtime_refresh_disabled; then
    echo "CodeXchange runtime refresh skipped by configuration."
    return 0
  fi

  ensure_runtime_tools
  PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - "$PROJECT" <<'PYCOX_COMMAND_CONFIG_RUNTIME_REFRESH_P101'
import json
import sys

sys.path.insert(0, sys.argv[1])
from codexchange_proxy.cli import _post_config_apply

print(json.dumps(_post_config_apply(), ensure_ascii=False, indent=2))
PYCOX_COMMAND_CONFIG_RUNTIME_REFRESH_P101
}

print_env_exports() {
  ensure_runtime_tools
  PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}" "$PYTHON_BIN" - "$PROJECT" "$ENV_FILE" <<'PYCOX_COMMAND_CONFIG_PRINT_ENV_P101'
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
from codexchange_proxy.env_file import read_env_exports, render_env_exports

path = Path(sys.argv[2])
values = read_env_exports(path)
selected = {
    key: value
    for key, value in values.items()
    if key in {
        "COX_MODEL_API_KEY",
        "COX_MODEL_PROVIDER",
        "COX_MODEL_BASE_URL",
        "COX_MODEL",
        "COX_REASONING_EFFORT",
    }
}
print(render_env_exports(selected), end="")
PYCOX_COMMAND_CONFIG_PRINT_ENV_P101
}

show_config() {
  ensure_env_file
  echo "ENV_FILE=$ENV_FILE"
  print_env_exports || true
  echo
  echo "CODEX_MAIN_CONFIG=$CODEX_CONFIG"
  if [ -f "$CODEX_CONFIG" ]; then
    grep -nA8 -E '^\[model_providers\.(deepseek|cox|[^]]+-proxy)' "$CODEX_CONFIG" || true
  else
    echo "missing"
  fi
  for profile in deepseek cox; do
    profile_file="$(codex_profile_path "$profile")"
    echo
    echo "CODEX_PROFILE_FILE=$profile_file"
    if [ -f "$profile_file" ]; then
      grep -nE '^(model|model_provider|model_reasoning_effort|plan_mode_reasoning_effort|model_context_window|model_auto_compact_token_limit|pricing_provider_id|pricing_provider_owned|pricing_mode|pricing_provider_path) = ' "$profile_file" || true
    else
      echo "missing"
    fi
  done
}

usage() {
  cat <<'USAGE'
Usage:
  cox-config show
  cox-config set-model <model>
  cox-config set-effort <high|max>
  cox-config set model <model> effort <high|max>
  cox-config config <cox-config-subcommand> [args...]

This compatibility shim keeps legacy cox-config commands working while the
provider-neutral product surface is the cox CLI:

  cox config set-model <model> --provider <provider>
  cox provider add --name <provider-id> --base-url <url> --model <model>
  cox profile status <profile>

Configuration-changing legacy commands refresh already-running CodeXchange
standard/reasoning proxies through the cox runtime lifecycle. Set
COX_CONFIG_RESTART_THINKING=0, COX_CONFIG_REFRESH_RUNTIME=0, or
COX_POST_CONFIG_APPLY=disabled to skip this compatibility refresh.
USAGE
}

main() {
  local cmd="${1:-show}"
  local model=""
  local effort=""

  case "$cmd" in
    show)
      show_config
      ;;
    set-model)
      shift || true
      [ "$#" -gt 0 ] || { usage >&2; return 2; }
      model="$1"
      shift || true
      set_export_var "COX_MODEL" "$model"
      patch_codex_model "$model"
      echo "model set to $model"
      apply_runtime_refresh
      ;;
    set-effort)
      shift || true
      [ "$#" -gt 0 ] || { usage >&2; return 2; }
      effort="$1"
      shift || true
      case "$effort" in high|max) ;; *) echo "ERROR: effort must be high or max" >&2; return 2 ;; esac
      set_export_var "COX_REASONING_EFFORT" "$effort"
      patch_codex_effort "$effort"
      echo "reasoning effort set to $effort"
      apply_runtime_refresh
      ;;
    set)
      shift || true
      while [ "$#" -gt 0 ]; do
        case "$1" in
          model)
            shift || true
            model="${1:-}"
            [ -n "$model" ] || { usage >&2; return 2; }
            set_export_var "COX_MODEL" "$model"
            patch_codex_model "$model"
            ;;
          effort)
            shift || true
            effort="${1:-}"
            [ -n "$effort" ] || { usage >&2; return 2; }
            case "$effort" in high|max) ;; *) echo "ERROR: effort must be high or max" >&2; return 2 ;; esac
            set_export_var "COX_REASONING_EFFORT" "$effort"
            patch_codex_effort "$effort"
            ;;
          *)
            usage >&2
            return 2
            ;;
        esac
        shift || true
      done
      show_config
      apply_runtime_refresh
      ;;
    config)
      shift || true
      run_cox_cli config "$@" --env-file "$ENV_FILE" --codex-config "$CODEX_CONFIG"
      ;;
    wizard|set-api-key|test-api-key|set-web-search-api-key|set-image-api-key|set-tool-routing|custom-provider)
      shift || true
      run_cox_cli config "$cmd" "$@" --env-file "$ENV_FILE"
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
