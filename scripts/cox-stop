#!/usr/bin/env bash
set -u

__codexchange_stop_main() {
  local install_dir python_bin
  if command -v cox >/dev/null 2>&1; then
    exec cox stop "$@"
  fi

  install_dir="${COX_INSTALL_DIR:-$HOME/.local/share/codexchange}"
  python_bin="${install_dir}/.venv/bin/python"
  if [ ! -x "$python_bin" ]; then
    python_bin="$(command -v python3 || true)"
  fi
  if [ -z "$python_bin" ]; then
    printf 'CodeXchange: cannot run lifecycle-aware stop; cox/python3 not found.\n' >&2
    return 127
  fi
  export PYTHONPATH="${install_dir}${PYTHONPATH:+:$PYTHONPATH}"
  exec "$python_bin" -m codexchange_proxy.cli stop "$@"
}

__codexchange_stop_main "$@"
